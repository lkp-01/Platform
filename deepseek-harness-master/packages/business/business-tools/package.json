{
  "name": "@deepseek-ai/dsh-business-tools",
  "description": "Scoped customer, data and operations tools over local demo fixtures",
  "version": "0.1.5-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./customer-service": {
      "types": "./lib/types/customer-service.d.ts",
      "default": "./lib/customer-service.js"
    },
    "./data-analysis": {
      "types": "./lib/types/data-analysis.d.ts",
      "default": "./lib/data-analysis.js"
    },
    "./operations": {
      "types": "./lib/types/operations.d.ts",
      "default": "./lib/operations.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/customer-service.js",
    "lib/data-analysis.js",
    "lib/operations.js",
    "lib/shared.js",
    "fixtures",
    "runtime",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-session-projection": "workspace:^",
    "@deepseek-ai/dsh-util-values": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/dsh-subprocess": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/dsh-session-projection": "workspace:^",
    "@deepseek-ai/dsh-util-values": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-agent-loop-testkit": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/business/business-tools"
  }
}
